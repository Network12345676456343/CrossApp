# Етап 1: Збірка з увімкненим Trimming
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY CrossApp.sln* ./
COPY src/Core/Core.csproj src/Core/
COPY src/Cli/Cli.csproj src/Cli/
RUN dotnet restore src/Cli/Cli.csproj

COPY src/Core/ src/Core/
COPY src/Cli/ src/Cli/

# Публікація: self-contained + single-file + trimmed
RUN dotnet publish src/Cli/Cli.csproj -c Release -r linux-x64 -f net10.0 \
    --self-contained true \
    -p:PublishSingleFile=true \
    -p:PublishTrimmed=true \
    -o /app/publish

# Етап 2: Мінімальний базовий Linux-образ (runtime-deps)
FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["./Cli"]